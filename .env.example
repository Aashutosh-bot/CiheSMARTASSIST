# Copy to .env (never commit the real file). Used by backend-data and backend-rag.
NODE_ENV=development            # set to "production" behind HTTPS: enables Secure cookies + HSTS and makes secrets mandatory
SESSION_SECRET=                 # required in production: openssl rand -hex 48
DATA_KEY=                       # required in production: 64 hex chars (openssl rand -hex 32). Encrypts data.json (AES-256-GCM)
ADMIN_EMAIL=admin@cihe.edu.au
ADMIN_PASSWORD=                 # 12+ chars. If unset in development a random one is printed once at first start
ALLOWED_ORIGINS=http://localhost:3000
NODE_BACKEND_URL=http://localhost:5000   # used by the Python server to validate sessions
# Moodle integration (unchanged)
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_COURSE_IDS=
